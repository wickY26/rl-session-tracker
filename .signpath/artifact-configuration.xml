<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for RL Session Tracker (paste into SignPath: Project → Artifact configurations).
  The release workflow uploads the installer with actions/upload-artifact, which wraps it in a zip:
  sign the NSIS installer (.exe) inside that zip with Authenticode.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="RLSessionTracker-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
